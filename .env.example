# DotEye - переменные окружения. Скопируй в .env и заполни.
# Значения здесь - примеры/пустые, реальные секреты не коммитить.

# Telegram-бот (получить токен: @BotFather)
DOTEYE_BOT_TOKEN=
# id админов через запятую. Пусто = доступ всем (dev-режим, без уведомлений)
DOTEYE_ADMIN_IDS=

# Режим: presence (детекция присутствия) | identity (распознавание лиц)
DOTEYE_DETECT_MODE=presence

# Источник: 0 = вебка, либо rtsp://... / http://... (телефон через IP Webcam)
DOTEYE_CAMERA_SOURCE=0

# Детектор: auto | yolo | yunet | motion
#   yolo   - ultralytics YOLO (нужен torch)
#   yunet  - OpenCV FaceDetectorYN (нужен ONNX-файл в DOTEYE_FACE_MODEL)
#   motion - MOG2-детектор движения (без моделей, грубо)
#   auto   - первый доступный: yolo -> yunet -> motion
DOTEYE_DETECTOR=auto

# YOLO модель и инференс
DOTEYE_MODEL_PATH=yolov8n.pt
DOTEYE_DEVICE=cpu
DOTEYE_MIN_CONFIDENCE=0.5
DOTEYE_DETECTION_INTERVAL=1.0
DOTEYE_COOLDOWN_SECONDS=30.0
DOTEYE_JPEG_QUALITY=85
DOTEYE_EVENTS_LIMIT=10

# Распознавание лиц (identity mode)
# порог дистанции embedding: меньше = строже
DOTEYE_FACE_THRESHOLD=0.4
# путь к ONNX-модели YuNet (для детектора yunet), напр. face_detection_yunet.onnx
DOTEYE_FACE_MODEL=

# Вынос обработки на отдельный сервер (в плане работ)
DOTEYE_REMOTE_PROCESSING=0
DOTEYE_REMOTE_URL=

# Ключ AES-256-GCM (32 байта в base64). Сгенерировать:
#   python -m doteye.crypto
DOTEYE_CRYPTO_KEY=

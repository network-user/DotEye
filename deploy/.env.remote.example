# DotEye remote-инференс - переменные окружения для сервера.
#
# Сгенерировано заполненным из deploy/deploy_remote.py; здесь примеры.
# DOTEYE_CRYPTO_KEY обязан совпадать с ключом на машине с камерой:
#   python -m doteye.crypto          -> вставить в обе .env

# Хост/домен, под которым remote доступен из интернета (Caddy auto-TLS).
DOTEYE_DOMAIN=eye.example.com

# Общий ключ AES-256-GCM + HMAC (32 байта base64). Без него сервер не стартует.
DOTEYE_CRYPTO_KEY=

# Модель и устройство инференса.
DOTEYE_MODEL_PATH=yolov8n.pt
DOTEYE_DEVICE=cpu
